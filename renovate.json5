{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>fohte/renovate-config:base.json5',
    'github>fohte/renovate-config:node.json5',
    'github>fohte/renovate-config:rust.json5',
  ],
  packageRules: [
    {
      // @bufbuild/protoc-gen-es requires the exact @bufbuild/protobuf version, but protobuf-es
      // isn't in group:monorepos, so the preset's "devDependencies (non-major)" group splits them.
      // @bufbuild/buf comes from bufbuild/buf and stays in that automerged group.
      matchSourceUrls: ['https://github.com/bufbuild/protobuf-es'],
      groupName: 'protobuf-es monorepo',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/vendor-octo-sts-proto$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+OCTO_STS_VERSION=(?<currentValue>\\S+)',
      ],
    },
  ],
}
