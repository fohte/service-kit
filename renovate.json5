{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>fohte/renovate-config:base.json5',
    'github>fohte/renovate-config:node.json5',
    'github>fohte/renovate-config:rust.json5',
  ],
  packageRules: [
    {
      // @bufbuild/protoc-gen-es requires the exact same @bufbuild/protobuf version,
      // but protobuf-es isn't in group:monorepos and the preset's
      // "devDependencies (non-major)" group splits protoc-gen-es from protobuf.
      // @bufbuild/buf is released from bufbuild/buf, so it stays in the automerged
      // devDependencies group.
      matchSourceUrls: ['https://github.com/bufbuild/protobuf-es'],
      groupName: 'protobuf-es monorepo',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/vendor-octo-sts-proto$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+OCTO_STS_VERSION=(?<currentValue>\\S+)',
      ],
    },
  ],
}
