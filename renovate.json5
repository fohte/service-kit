{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>fohte/renovate-config:base.json5',
    'github>fohte/renovate-config:node.json5',
    'github>fohte/renovate-config:rust.json5',
  ],
  packageRules: [
    {
      // @bufbuild/protoc-gen-es requires @bufbuild/protobuf as a peer at the exact same version,
      // but the preset's "devDependencies (non-major)" group separates them.
      // The first upgrade is @bufbuild/buf, a devDependency that inherits the preset's chore: prefix.
      // Clear that prefix to use deps:, so toolchain updates that affect published generated code
      // trigger a release.
      matchPackageNames: ['@bufbuild/**'],
      groupName: 'bufbuild',
      commitMessagePrefix: null,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/vendor-octo-sts-proto$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+OCTO_STS_VERSION=(?<currentValue>\\S+)',
      ],
    },
  ],
}
