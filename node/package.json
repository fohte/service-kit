{
  "name": "@fohte/service-kit",
  "version": "0.1.7",
  "private": false,
  "description": "Service bootstrap kit for Node.js: observability and other cross-cutting concerns shared across services.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fohte/service-kit.git",
    "directory": "node"
  },
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js"
    },
    "./langchain-genai": {
      "types": "./dist/langchain-genai/index.d.ts",
      "import": "./dist/langchain-genai/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./otel-register": {
      "types": "./dist/otel-register.d.ts",
      "import": "./dist/otel-register.js"
    },
    "./retry": {
      "types": "./dist/retry/index.d.ts",
      "import": "./dist/retry/index.js"
    },
    "./shutdown": {
      "types": "./dist/shutdown/index.d.ts",
      "import": "./dist/shutdown/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && ! grep -rn \"from '#\" dist",
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "langchain": "^1.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "langchain": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "0.77.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.219.0",
    "@opentelemetry/instrumentation": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@sentry/node": "10.58.0",
    "@sentry/opentelemetry": "10.58.0",
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@eslint/eslintrc": "3.3.6",
    "@fohte/eslint-config": "0.4.0",
    "@langchain/core": "1.2.3",
    "@ninoseki/eslint-plugin-neverthrow": "0.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.8.0",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "concurrently": "10.0.3",
    "eslint": "10.6.0",
    "langchain": "1.5.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsc-alias": "1.8.17",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
