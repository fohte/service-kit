#!/usr/bin/env bash
#
# Vendor the octo-sts /sts/exchange response schema from chainguard.dev/sdk.
#
# octo-sts/app pins chainguard.dev/sdk in its go.mod; that pin, not
# octo-sts/app's own version, decides which proto schema is live at the
# octo-sts endpoint. This script re-derives the sdk version from the
# octo-sts/app tag below and re-fetches only oidc.platform.proto. The
# vendored google/api/* files are frozen copies unrelated to the octo-sts
# version and are left untouched.
#
# Usage:
#   scripts/vendor-octo-sts-proto

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# renovate: datasource=go depName=github.com/octo-sts/app
OCTO_STS_VERSION=v0.7.2

sdk_version="$(
  curl -sSfL "https://raw.githubusercontent.com/octo-sts/app/${OCTO_STS_VERSION}/go.mod" |
    grep -E '^\s*chainguard\.dev/sdk\s' |
    awk '{print $2}'
)"

curl -sSfL \
  "https://raw.githubusercontent.com/chainguard-dev/sdk/${sdk_version}/proto/platform/oidc/v1/oidc.platform.proto" \
  -o proto/platform/oidc/v1/oidc.platform.proto
